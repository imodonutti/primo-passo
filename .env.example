# Catena di motori AI, in ordine di preferenza: fornitore:modello separati da virgole.
# Fornitori: gemini, openrouter, groq. Ogni messaggio va al primo motore pronto; chi risponde
# "quota finita" o "sovraccarico" va in pausa per il tempo indicato dal fornitore.
# Nessun motore con chiave = modalita' DEMO senza AI.
MOTORI=gemini:gemini-3.8-flash,gemini:gemini-3.5-flash-lite,gemini:gemini-2.5-flash
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# deny = esclude i fornitori OpenRouter che conservano o addestrano sui prompt (consigliato con clienti veri)
OPENROUTER_DATA_COLLECTION=deny
GROQ_API_KEY=
# Clienti UE: con Gemini serve un progetto con fatturazione attiva (vedi README).

# Token per il pannello /admin (lungo e casuale, es. openssl rand -hex 24)
ADMIN_TOKEN=

# Facoltativo: webhook n8n chiamato quando il cliente conferma il brief
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

PORT=3000
