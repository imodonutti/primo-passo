# Chiave Gemini (Google AI Studio). Vuota = modalità DEMO senza AI.
# Per clienti in Italia/UE serve un progetto con fatturazione attiva (vedi README).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Token per il pannello /admin (lungo e casuale, es. openssl rand -hex 24)
ADMIN_TOKEN=

# Facoltativo: webhook n8n chiamato quando il cliente conferma il brief
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

PORT=3000
